# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Python build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
.Python

# Python test, lint, and type-check caches
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.pyre/
.pytype/

# Virtual environments and local env files
.venv/
venv/
env/
ENV/
.env
.env.*

# Node.js dependencies and package manager state
node_modules/
.pnp/
.pnp.js
.npm/
.pnpm-store/

# Yarn Berry keeps selected project metadata in version control.
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/
!.yarn/versions/

# Node.js logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node.js build and framework outputs
coverage/
.nyc_output/
.next/
.nuxt/
.svelte-kit/
.vite/
out/
public/build/
